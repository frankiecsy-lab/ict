# ICT Trader 配置範本——複製做 .env（Windows: copy .env.example .env / Ubuntu: cp）
# 已存在嘅程序環境變數優先於呢個檔案（load_dotenv override=False）。
# 所有值都係可選：留空/刪除該行即用預設值。

# --- 富途 OpenD 連線 ---
FUTU_OPEND_HOST=127.0.0.1
FUTU_OPEND_PORT=11111

# --- 行情 ---
TRADING_CODE=HK.HSImain
# K 線週期：K_1M/K_3M/K_5M/K_15M/K_30M/K_60M/K_DAY/K_WEEK/K_MON（未知值啟動報錯）
KLINE_TYPE=K_1M
# 歷史 K 線根數（≥1）
HISTORY_COUNT=1000

# --- 圖表顯示 ---
# 圖表右 pin 顯示嘅蠟燭數（≥1）
VISIBLE_BARS=120
# 蠟燭顏色慣例：HK=紅漲綠跌 / INTL=綠漲紅跌（未知值回落 HK）
CONVENTION=HK
# 手動 override 色值（留空=跟隨 CONVENTION），如 #FF4D4F
COLOR_UP=
COLOR_DOWN=

# --- 深色主題配色（可覆蓋）---
BG_COLOR=#101418
GRID_COLOR=#1E2530
TEXT_COLOR=#D6DEE8
AXIS_TEXT_COLOR=#7A8699
LAST_PRICE_COLOR=#FFB020

# --- 除錯 ---
# tick log 等除錯輸出（1/true/yes/on 為真）
DEBUG=false
