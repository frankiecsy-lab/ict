# ICT Trader 配置範本——複製做 .env（Windows: copy .env.example .env / Ubuntu: cp）
# 已存在嘅程序環境變數優先於呢個檔案（load_dotenv override=False）。
# 所有值都係可選：留空/刪除該行即用預設值。

# --- 富途 OpenD 連線（Commit 35：報價 / 交易拆成兩個獨立端點，可指向不同 OpenD 實例）---
# 下單頁「OpenD 連線設定」面板可直接修改並儲存（寫入本檔案）+ 逐端點連線測試。
# FUTU_QUOTE_HOST/PORT = 報價 OpenD（K 線 / 推送）；FUTU_TRADE_HOST/PORT = 交易 OpenD（下單 / 查詢）。
# 留空 → fallback FUTU_OPEND_HOST/PORT（legacy 單一端點設定仍然有效）。
FUTU_QUOTE_HOST=127.0.0.1
FUTU_QUOTE_PORT=11111
FUTU_TRADE_HOST=127.0.0.1
FUTU_TRADE_PORT=11111
# legacy 單一端點（兩個端點都留空時嘅 fallback）
FUTU_OPEND_HOST=127.0.0.1
FUTU_OPEND_PORT=11111

# --- 行情 ---
TRADING_CODE=HK.HSImain
# K 線週期：K_1M/K_3M/K_5M/K_15M/K_30M/K_60M/K_DAY/K_WEEK/K_MON（未知值啟動報錯）
KLINE_TYPE=K_1M
# 歷史 K 線根數（≥1）
HISTORY_COUNT=1000
# SMT Divergence 配對副標的（如 US.QQQ，需同 TRADING_CODE 高度相關）；留空 = 功能關閉（SMT 按鍵隱藏）
SMT_CODE=

# --- 圖表顯示 ---
# 圖表初始/預設可見蠟燭數（≥1；wheel 縮放可即時改，雙擊 reset 返呢個值）
VISIBLE_BARS=120
# 蠟燭顏色慣例：HK=紅漲綠跌 / INTL=綠漲紅跌（未知值回落 HK）
CONVENTION=HK
# 手動 override 色值（留空=跟隨 CONVENTION），如 #FF4D4F
COLOR_UP=
COLOR_DOWN=

# --- 深色主題配色（可覆蓋；疊加去默認暗色主題——應用內 ☀️/🌙 按鍵切換淺色/暗色，切返暗色保留呢度自訂）---
BG_COLOR=#101418
GRID_COLOR=#1E2530
TEXT_COLOR=#D6DEE8
AXIS_TEXT_COLOR=#7A8699
LAST_PRICE_COLOR=#FFB020

# --- 下單版面（交易）---
# OpenSecTradeContext 市場列表（comma-separated；每個市場一個 trading context）。
# 前綴須與標的 code 一致（HK.00700 → HK / US.AAPL → US）；未知值忽略。
TRD_MARKETS=HK,US

# --- 除錯 ---
# tick log 等除錯輸出（1/true/yes/on 為真）
DEBUG=false
